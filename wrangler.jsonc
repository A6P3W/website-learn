{
  "name": "website-learn-lab",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "website-learn-db",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}